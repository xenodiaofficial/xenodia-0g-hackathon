# The copied Xenodia frontend mirror is local-development context only.
# Keep it available on disk, but do not let a blind `git add .` publish the
# full product UI, internal docs, provider-console flows, or helper scripts.
# Only the 0G-specific, judge-visible slices below are allowed through.
frontend/**
!frontend/.gitignore
!frontend/app/
frontend/app/**
!frontend/app/api/
frontend/app/api/**
!frontend/app/api/0g/
!frontend/app/api/0g/**
